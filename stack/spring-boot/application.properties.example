# Add these lines to your existing src/main/resources/application.properties
# (change the database name, user and password to yours)

spring.datasource.url=jdbc:mysql://localhost:3306/interview_db?createDatabaseIfNotExist=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD

# Creates/updates the two new tables automatically. Use "none" if you ran database/schema.sql yourself.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false

# Where the Python feedback service runs
feedback.service.url=http://localhost:8000

# React dev server origins (CRA = 3000, Vite = 5173)
feedback.cors.allowed-origins=http://localhost:3000,http://localhost:5173

# Show readable error messages (e.g. "No transcript saved for session 1.")
server.error.include-message=always

# ----------------------------------------------------------------------
# pom.xml: make sure these dependencies exist (Spring Boot 3.x, Java 17+)
#
#   <dependency>
#     <groupId>org.springframework.boot</groupId>
#     <artifactId>spring-boot-starter-web</artifactId>
#   </dependency>
#   <dependency>
#     <groupId>org.springframework.boot</groupId>
#     <artifactId>spring-boot-starter-data-jpa</artifactId>
#   </dependency>
#   <dependency>
#     <groupId>com.mysql</groupId>
#     <artifactId>mysql-connector-j</artifactId>
#     <scope>runtime</scope>
#   </dependency>
#
# Gradle equivalent:
#   implementation 'org.springframework.boot:spring-boot-starter-web'
#   implementation 'org.springframework.boot:spring-boot-starter-data-jpa'
#   runtimeOnly 'com.mysql:mysql-connector-j'
